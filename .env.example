# Moth Quantum API key (server-side only; never commit, log or send to a browser)
MOTH_API_KEY=your-key-from-platform.mothquantum.com

# Production server only (the dev server needs none of these):
# Sites allowed to open a WebSocket to the game server, comma-separated
# ALLOWED_ORIGINS=https://vincentschall.com
# Most Moth credits the server may spend per UTC day; after that it uses local randomness
# MOTH_DAILY_CREDITS=100
# Start a background QPU job when the bit pool has fewer unused bits than this (0 = off)
# POOL_MIN_BITS=5000
