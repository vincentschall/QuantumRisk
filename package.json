{
  "name": "quantumrisk",
  "version": "0.1.0",
  "private": true,
  "description": "QuantumRisk: deterministic conquest with quantum superposition",
  "type": "module",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit && tsc -p web --noEmit",
    "test": "tsx --test test/*.test.ts",
    "sim": "tsx src/sim/run.ts",
    "moth": "tsx src/node/mothCli.ts",
    "dev": "tsx src/node/dev.ts",
    "server": "tsx src/server/main.ts",
    "web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "map:svg": "tsx --tsconfig web/tsconfig.json web/scripts/renderBoard.tsx design/map.svg"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.23.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  }
}
